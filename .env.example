# Hermes Companion v0.3 control plane
APP_ENV=production
APP_SECRET=replace-with-at-least-32-random-bytes
DATABASE_PATH=./services/bridge/data/hermes_companion.db
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost,tauri://localhost,http://tauri.localhost,https://tauri.localhost
WEB_DIST_DIR=./apps/web/dist
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=2097152

# First startup creates this administrator only when no users exist.
INITIAL_ADMIN_EMAIL=nik@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Hermes API listener stays on loopback. The bridge is the only public surface.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_PROFILES_FILE=./config/profiles.json
HERMES_REQUEST_TIMEOUT_SECONDS=60
HERMES_CONNECT_TIMEOUT_SECONDS=10
HERMES_SSE_MAX_SECONDS=21600

# One distinct key per regular Hermes profile. Configure matching keys in Hermes.
HERMES_API_KEY_DEFAULT=
HERMES_API_KEY_MENTOS=
HERMES_API_KEY_LANEB_LAB=
HERMES_API_KEY_MQL5_FORGE=
HERMES_API_KEY_AGENTIC_TRADING=
HERMES_API_KEY_POLYMARKET=

# Optional full Hermes WebSocket control plane (`hermes serve`).
# Keep this service loopback-only; the bridge creates one-time client tickets.
HERMES_SERVE_URL=http://127.0.0.1:9119
HERMES_SERVE_SESSION_TOKEN=
GATEWAY_TICKET_SECONDS=60
GATEWAY_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_MAX_MESSAGE_BYTES=2097152
# Leave unset to use the bridge's reviewed method allowlist.
GATEWAY_ALLOWED_METHODS=

# Secure Companion file inbox.
UPLOAD_ROOT=./services/bridge/data/uploads
MAX_UPLOAD_BYTES=26214400
UPLOAD_RETENTION_DAYS=30
# Optional scanner executable and arguments; the uploaded file path is appended.
# Windows Defender example: UPLOAD_SCAN_COMMAND="C:\\Program Files\\Windows Defender\\MpCmdRun.exe" -Scan -ScanType 3 -File
UPLOAD_SCAN_COMMAND=
UPLOAD_SCAN_TIMEOUT_SECONDS=30
# Optional override; extensions are comma-separated.
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.csv,.tsv,.json,.jsonl,.yaml,.yml,.toml,.py,.js,.mjs,.cjs,.ts,.tsx,.jsx,.html,.css,.sql,.xml,.log,.ini,.cfg,.mq5,.mqh,.set,.pdf,.png,.jpg,.jpeg,.webp,.gif

BACKUP_ROOT=./backups
NOTIFICATION_RETENTION_DAYS=30

# Default mobile policy only exposes "approve once" and "deny".
ALLOW_WIDE_APPROVALS=false

# Optional public HTTPS URL used when generating handoff links.
PUBLIC_APP_URL=
